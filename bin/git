#!/usr/bin/env bash
# git as muse-corva[bot] for commit/push-ish commands on installed repos; plain git otherwise
set -uo pipefail
. "$(dirname "$0")/_lib.sh"
REAL_GIT=$(real git "${MUSE_CORVA_REAL_GIT:-}") || { echo "muse-corva: real git not found" >&2; exit 127; }
off && exec "$REAL_GIT" "$@"
pre=(); i=1
while [ $i -le $# ]; do               # skip global options to find the subcommand
  a=${!i}
  case "$a" in
    -C|-c) j=$((i + 1)); pre+=("$a" "${!j}"); i=$((i + 2)) ;;
    -*) pre+=("$a"); i=$((i + 1)) ;;
    *) break ;;
  esac
done
sub=${!i:-}
case "$sub" in
  commit|merge|rebase|cherry-pick|revert|am|tag|push|fetch|pull) ;;
  *) exec "$REAL_GIT" "$@" ;;
esac
repo=$(origin_repo "${pre[@]+"${pre[@]}"}")
if [ -n "$repo" ] && tok=$(token_for "$repo"); then
  slug=$(jq -r .slug "$app"); uid=$(jq -r .bot_user_id "$app")
  export GIT_AUTHOR_NAME="$slug[bot]" GIT_COMMITTER_NAME="$slug[bot]"
  email="$uid+$slug[bot]@users.noreply.github.com"
  export GIT_AUTHOR_EMAIL="$email" GIT_COMMITTER_EMAIL="$email"
  export MUSE_CORVA_GIT_TOKEN=$tok
  n=${GIT_CONFIG_COUNT:-0}
  export "GIT_CONFIG_KEY_$n=credential.https://github.com.helper" "GIT_CONFIG_VALUE_$n="
  export "GIT_CONFIG_KEY_$((n + 1))=credential.https://github.com.helper"
  export "GIT_CONFIG_VALUE_$((n + 1))=!f(){ echo username=x-access-token; echo \"password=\$MUSE_CORVA_GIT_TOKEN\"; }; f"
  export "GIT_CONFIG_KEY_$((n + 2))=credential.https://github.com.username" "GIT_CONFIG_VALUE_$((n + 2))=x-access-token"
  export GIT_CONFIG_COUNT=$((n + 3))
fi
exec "$REAL_GIT" "$@"
