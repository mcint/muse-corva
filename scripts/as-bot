#!/usr/bin/env bash
# as-bot <cmd...>   run a command as muse-corva[bot]:
#   GH_TOKEN for gh, git https credentials for github.com, bot author/committer.
# Repo for the token: MUSE_CORVA_REPO=owner/repo, else origin of the current dir.
set -euo pipefail
here=$(cd "$(dirname "$0")/.." && pwd)
[ $# -gt 0 ] || { sed -n '2,4p' "$0" >&2; exit 2; }
GH_TOKEN=$("$here/scripts/token.sh" ${MUSE_CORVA_REPO:-}); export GH_TOKEN
slug=$(jq -r .slug "$here/apps/muse-corva/app.json")
uid=$(jq -r .bot_user_id "$here/apps/muse-corva/app.json")
export GIT_AUTHOR_NAME="$slug[bot]" GIT_COMMITTER_NAME="$slug[bot]"
export GIT_AUTHOR_EMAIL="$uid+$slug[bot]@users.noreply.github.com" GIT_COMMITTER_EMAIL="$uid+$slug[bot]@users.noreply.github.com"
# reset inherited helpers for github.com, then answer with the installation token
export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0=credential.https://github.com.helper GIT_CONFIG_VALUE_0=
export GIT_CONFIG_KEY_1=credential.https://github.com.helper
export GIT_CONFIG_VALUE_1='!f(){ echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
exec "$@"
